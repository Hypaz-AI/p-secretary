# ============================================================
#  PI-SECRETARY — Configurazione di esempio (nessun segreto reale)
#  Per una NUOVA installazione copia in .env e compila i valori.
#  NON sovrascrivere un .env esistente: aggiungi solo le chiavi mancanti.
#  Proteggi .env con permessi 600; non includerlo in Git o ZIP condivisi.
#  Sintassi: KEY=value, una variabile per riga, commenti su righe separate.
#  Non mettere commenti dopo un valore: il parser li leggerebbe come valore.
#  Dopo le modifiche riavvia pi-secretary: .env non viene riletto dal servizio.
#  Gli interruttori della dashboard sono invece persistenti nel database.
# ============================================================

# --- Agente e provider AI (OpenRouter) -----------------------
AGENT_NAME=Pi Secretary
# Chiave API (https://openrouter.ai/keys). Resta nel processo dell'app: il runtime
# dell'agente parla solo con un gateway locale e non la vede mai.
OPENROUTER_API_KEY=
# Modello dell'AGENTE (deve supportare il tool calling). openrouter/auto lascia a
# OpenRouter la scelta del modello in base alla richiesta.
AGENT_MODEL=openrouter/auto
# Modello che esegue la ricerca web (plugin web di OpenRouter); vuoto = OPENROUTER_MODEL.
# AGENT_WEB_MODEL=
# Modello per descrivere le immagini e trascrivere i media archiviati: DEVE
# supportare nativamente testo e immagini (image_url). Non è il modello dell'agente.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
# Limiti dell'agente (valori di default; intervalli validati all'avvio):
# AGENT_MAX_TOOL_CALLS=30        chiamate agli strumenti per turno (1-200)
# AGENT_OWNER_TIMEOUT=240        secondi per un turno richiesto da te (30-1800)
# AGENT_BACKGROUND_TIMEOUT=900   secondi per triage e riepilogo (60-3300)
# AGENT_LLM_TIMEOUT=180          secondi per ogni richiesta al provider (20-600)
# AGENT_MAX_OUTPUT_TOKENS=16384  token massimi di output per richiesta (1024-65536)
# AGENT_INBOX_BATCH=8            messaggi in arrivo valutati insieme (1-25)
# AGENT_NOTIFY_MAX_PER_DAY=5     avvisi autonomi urgenti al giorno (0-100)
# AGENT_HISTORY_RESPONSE_MINUTES=20  minuti per cui le risposte passate rientrano nel contesto (0-240)
# AGENT_WORKSPACE_QUOTA_MB=200   quota della cartella workspace/ scrivibile dall'agente
# AGENT_DB_SCHEMA=agent          schema delle viste che l'agente può interrogare
# AGENT_DB_ROLE=agent_ro         ruolo di sola lettura, creato dall'app se può (vedi deploy/agent_ro.sql); vuoto = nessun ruolo

# --- Modalità e budget AI -------------------------------------
# Modalità operativa: observe (default, solo proposte/bozze, NESSUN invio di email
# a terzi) oppure active (permette l'invio delle bozze che approvi con /invia).
# Valori non riconosciuti ricadono su observe (fail-safe).
SECRETARY_MODE=observe
# Consensi AI: pagina Permessi AI della dashboard, separati per sorgente/effetto.
# Nessuna riga data_policies = negato. Nessun consenso automatico dal wizard.
# Telegram copre bot+account personale; non esiste consenso per singola chat.
# Budget AI (giorni UTC): ogni richiesta dell'agente passa dal ledger; input e
# output massimo sono prenotati conservativamente, senza rimborsi; l'usage reale
# maggiore è addebitato. Ledger o DB non disponibili = richiesta rifiutata.
# Configurazione web: interi positivi fino a 2147483647 (output fino a 65536).
AI_BUDGET_DAILY_CALLS=200
AI_BUDGET_DAILY_TOKENS=500000
AI_BUDGET_MAX_INFLIGHT=2
AI_BUDGET_MAX_OUTPUT_TOKENS=65536
# Tetti opzionali per scope, dentro il tetto globale (0 o assente = nessun tetto di scope):
# AI_BUDGET_AGENT_OWNER_DAILY_CALLS=   turni richiesti da te
# AI_BUDGET_AGENT_INBOX_DAILY_CALLS=   triage della posta in arrivo e riepilogo serale
# Tetto monetario giornaliero opzionale (valuta del provider): quando la somma dei
# costi RIPORTATI dal provider lo raggiunge, le richieste falliscono chiuse.
# 0 o assente = disattivato. Le richieste senza costo riportato non contano:
# imposta anche un limite di spesa sulla chiave presso OpenRouter.
AI_BUDGET_DAILY_COST=0
# Fatture/monthly_zip: solo flow_settings DB, niente nuovi flag env.
# Profilo nuovo: opzionali off; upgrade: flag espliciti preservati.

# --- Email (IMAP / SMTP) -------------------------------------
# Dashboard: Prepara invio -> Approva -> Invio esplicito (tre operazioni separate).
# Mittente account_address e unico destinatario obbligatori, senza default account.
# Oggetto fisso mostrato: Messaggio approvato. Invio solo testo, NO allegati.
# Richiede execution.migrate e worker secretary_email_execution nel bootstrap.
# Accettato dal connettore non significa consegnato/letto; esito incerto non reinviato.
# Fino a 50 account: basta aggiungere blocchi EMAIL1_*, EMAIL2_*, EMAIL3_*...
#
# EMAIL{n}_PROVIDER imposta i server giusti automaticamente:
#   gmail       → Google: serve una "password per app" (vedi README)
#   outlook     → Microsoft personale (outlook/hotmail/live): OAuth2
#   m365        → Microsoft 365 lavoro/scuola: OAuth2
#   zimbra_ovh  → Zimbra hostato su OVH: password della casella
#   custom      → server a mano: aggiungi EMAIL{n}_IMAP_HOST e _SMTP_HOST
#
# Gli account Microsoft NON vogliono password qui: dopo aver scritto
# l'indirizzo esegui  python3 setup_ms_auth.py  (login da browser/phone).

# --- Google 1 ---
EMAIL1_ADDRESS=
EMAIL1_PASSWORD=
EMAIL1_PROVIDER=gmail
EMAIL1_NAME=Gmail 1

# --- Google 2 ---
EMAIL2_ADDRESS=
EMAIL2_PASSWORD=
EMAIL2_PROVIDER=gmail
EMAIL2_NAME=Gmail 2

# --- Google 3 ---
EMAIL3_ADDRESS=
EMAIL3_PASSWORD=
EMAIL3_PROVIDER=gmail
EMAIL3_NAME=Gmail 3

# --- Google 4 ---
EMAIL4_ADDRESS=
EMAIL4_PASSWORD=
EMAIL4_PROVIDER=gmail
EMAIL4_NAME=Gmail 4

# --- Microsoft personale (OAuth2 → python3 setup_ms_auth.py) ---
EMAIL5_ADDRESS=
EMAIL5_PROVIDER=outlook
EMAIL5_NAME=Outlook personale

# --- Microsoft 365 lavoro (OAuth2 → python3 setup_ms_auth.py) ---
EMAIL6_ADDRESS=
EMAIL6_PROVIDER=m365
EMAIL6_NAME=M365 lavoro

# --- Zimbra su OVH ---
EMAIL7_ADDRESS=
EMAIL7_PASSWORD=
EMAIL7_PROVIDER=zimbra_ovh
EMAIL7_NAME=Zimbra

# Esempio di server "custom":
# EMAIL8_ADDRESS=utente@example.com
# EMAIL8_PASSWORD=...
# EMAIL8_PROVIDER=custom
# EMAIL8_IMAP_HOST=imap.example.com
# EMAIL8_SMTP_HOST=smtp.example.com
# EMAIL8_NAME=Altro

# --- Telegram BOT: dialogo con il segretario e invio dei report ---
# Il bot NON legge la casella personale Telegram: per quella vedi MTProto.
# 1) Parla con @BotFather su Telegram, crea un bot, incolla il token.
# 2) Scrivi almeno un messaggio al tuo bot, poi apri
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    e copia il tuo chat id qui sotto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram ACCOUNT PERSONALE: lettura tramite MTProto --------
# Credenziali da https://my.telegram.org -> API development tools.
# API ID e API hash NON sono il token del bot. Non servono public keys manuali.
# 1. Compila API_ID, API_HASH e PHONE (numero con prefisso internazionale).
# 2. Esegui .venv/bin/python setup_telegram_account.py nel tuo terminale.
#    Codice login e password 2FA SOLO nel terminale: mai qui né in chat.
#    Cerca il codice nella chat di servizio ufficiale "Telegram" (anche archiviate),
#    sull'account del numero configurato. SMS non garantiti. Non è il codice
#    di my.telegram.org né il token del bot. Se non arriva, esci con q e verifica
#    il numero; evita richieste ripetute ravvicinate.
# 3. Dopo "Session authorized", abilita e riavvia il servizio.
#    Anche il flusso telegram_user nella dashboard deve essere abilitato.
TELEGRAM_USER_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# File creato dallo script dopo il login, non una chiave da ottenere.
# Proteggi la sessione come una password: mai Git/ZIP condivisi.
# Lascia vuoto per usare il percorso predefinito dell'installazione.
TELEGRAM_USER_SESSION=
# Recupero SOLO ieri/oggi nel TIMEZONE indicato sotto; limiti per passata.
# Non è un import storico completo. Telegram FloodWait viene rispettato.
TELEGRAM_USER_DIALOG_LIMIT=100
TELEGRAM_USER_MESSAGE_LIMIT=200
TELEGRAM_USER_RECOVERY_INTERVAL=900

# --- WhatsApp (whatsapp-web.js + Chromium di sistema) -----------
# true = abilita il ponte WhatsApp (genera QR la prima volta)
WHATSAPP_ENABLED=false

# --- Google Calendar (python3 setup_gcal.py) -----------------
# L'agente può fissare appuntamenti sul tuo Google Calendar e
# sincronizza quelli che rileva nelle comunicazioni.
#
# UNICA MODALITÀ — SERVICE ACCOUNT IAM (nessun login utente,
# nessuna scadenza):
#   1. https://console.cloud.google.com → progetto con API «Google
#      Calendar» abilitata → IAM → Account di servizio → Crea
#      (nessun ruolo necessario) → Chiavi → Aggiungi chiave → JSON
#   2. Nel setup incolla il JSON nascosto (riga FINE) o importa il file
#      Salvataggio atomico 0600 in data/gcal_service_account.json
#      (o imposta GCAL_SERVICE_ACCOUNT_FILE con un percorso diverso)
#   3. Nella chiave trovi "client_email": copialo e condividi con esso
#      il TUO calendario da calendar.google.com (permesso «Apportare
#      modifiche agli eventi»), come faresti con una persona.
#   4. python3 setup_gcal.py  → verifica lettura/scrittura e attiva.
# La chiave vale finché non la revochi: niente da rinnovare.
#
# Docker: /var/lib/pi-secretary/gcal_service_account.json corrisponde a
# PI_SECRETARY_HOME/data/gcal_service_account.json sull'host.
# Nessuna alternativa OAuth utente; vecchi token Calendar sono ignorati.
GCAL_ENABLED=false
# Chiave JSON dell'account di servizio (percorso; default sotto)
GCAL_SERVICE_ACCOUNT_FILE=
# ID esplicito del calendario condiviso; NON usare primary
GCAL_CALENDAR_ID=
# durata predefinita (minuti) degli eventi creati dall'agente
GCAL_EVENT_DURATION=60

# --- Database Postgres (contesto / memoria del segretario) -----
# URI completo: postgresql://utente:password@host:porta/database
# Può essere locale O remoto: tutti i flussi usano questo stesso URI.
# Inserisci l'URI reale; codifica percentualmente i caratteri speciali
# di utente/password. Il database deve consentire scritture.
# Esempio locale (solo illustrativo):
# postgresql://utente:password@localhost:5432/pi_secretary
# Esempio remoto con verifica TLS (sostituisci tutti i segnaposto):
# postgresql://utente:password@db.example.com:5432/pi_secretary?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=

# --- Fatture ----------------------------------------------------
# Cartella base dove salvare le fatture ricevute (struttura:
# INVOICE_DIR/<entità>/<aaaa-mm>/<nome>.pdf)
# Imposta un percorso adatto alla tua installazione.
INVOICE_DIR=
# Entità di esempio: il nome della cartella è quello che l'AI usa
# per capire a chi è intestata la fattura.
# La P.IVA viene passata all'AI come indizio di classificazione:
# se il testo della fattura la cita (con o senza prefisso IT),
# l'AI sa a quale entità intestarla. Formato consigliato: IT + 11 cifre.
INVOICE_ENTITY1_NAME=azienda_esempio
INVOICE_ENTITY1_VAT=
INVOICE_ENTITY1_DESC=Azienda di esempio
INVOICE_ENTITY2_NAME=professionista_esempio
INVOICE_ENTITY2_VAT=
INVOICE_ENTITY2_DESC=Professionista di esempio
INVOICE_ENTITY3_NAME=altra_entita
INVOICE_ENTITY3_VAT=
INVOICE_ENTITY3_DESC=Altra entità di esempio

# --- Riassunto giornaliero ---------------------------------------
# Ora locale (HH:MM) a cui ricevere via bot il riepilogo delle ultime 24 ore
# (finestra mobile: dalle HH:MM del giorno prima a HH:MM di oggi)
# Include il piano delle prossime 48 ore dalle attività aperte, anche senza
# nuove comunicazioni. Scadenze note: promemoria e calendario senza duplicati;
# attività senza data: prossimi passi suggeriti, senza inventare appuntamenti.
DIGEST_TIME=21:00
# Avvisi autonomi: l'agente avvisa subito SOLO per vere emergenze, fino a
# AGENT_NOTIFY_MAX_PER_DAY al giorno; tutto il resto compare nel riepilogo serale.

# --- Comportamento --------------------------------------------
# Ogni quanti secondi controllare le email (default 300 = 5 min)
POLL_INTERVAL=300
# Fuso orario per appuntamenti/promemoria
TIMEZONE=Europe/Rome
# Lingua dell'assistente
LANGUAGE=it
# Cartella dove salvare appuntamenti e note
# Lascia vuoto per usare il percorso predefinito dell'installazione.
DATA_DIR=

# --- Dashboard locale (nello stesso servizio pi-secretary) -----
# URL di esempio: http://pi-secretary.local/ (porta 80).
# 0.0.0.0 espone sulla LAN: HTTP non cifrato, solo rete fidata.
# Porta 80 richiede l'override systemd deploy/dashboard-port80.conf;
# non eseguire l'applicazione come root per questo motivo.
# L'ambiente systemd ha precedenza sui valori di .env.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=80
DASHBOARD_HOSTNAME=pi-secretary.local
# false per HTTP locale; true SOLO quando si accede tramite HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Login dedicato generato in ~/.config/pi-secretary/dashboard.json.
# Non inserire qui password della dashboard o password dell'utente Linux.