# ============================================================
#  PI-SECRETARY — .gitignore
#  Esclude segreti, stato locale e file generati.
#  `data/` è solo stato di runtime (default di DATA_DIR fuori da Docker):
#  il manifest del ponte WhatsApp (package.json) vive in deploy/whatsapp/.
# ============================================================

# --- Segreti e configurazione locale ------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Stato e dati di runtime (credenziali, sessioni, media, code) ---
data/
.env.lock
.env.*.lock

# --- Sessioni (Telegram / WhatsApp) -------------------------
#    copre anche journal fuori da data/ (es. *.session-journal)
*.session
*.session-*
*.session.*

# --- Node ---------------------------------------------------
node_modules/

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Log e file temporanei ----------------------------------
*.log
*.tmp
*.swp
.DS_Store
