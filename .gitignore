# ============================================================
#  PI-SECRETARY — .gitignore
#  Esclude segreti, stato locale e file generati.
#  NB: non si ignora "data/" in blocco, così restano versionabili
#  i file sorgente del ponte WhatsApp (package.json / lockfile).
# ============================================================

# --- Segreti e configurazione locale ------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Credenziali e token (in data/) -------------------------
data/gcal_service_account.json
data/gcal_tokens.json
data/ms_tokens.json

# --- Stato e cache di runtime -------------------------------
data/state.json
data/.wwebjs_cache/

# --- Sessioni (Telegram / WhatsApp) -------------------------
#    copre anche journal fuori da data/ (es. *.session-journal)
*.session
*.session-*
*.session.*
data/telegram_account/
data/wa_session/

# --- Media, code e archivi generati -------------------------
data/wa_media/
data/wa_pending/
data/tg_files/
data/email_attachments/
data/zips/

# --- Ponte WhatsApp generato (sorgente in connectors/whatsapp.py) ---
data/wa_bridge.js

# --- Node ---------------------------------------------------
node_modules/
data/node_modules/

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Log e file temporanei ----------------------------------
*.log
*.tmp
*.swp
.DS_Store
